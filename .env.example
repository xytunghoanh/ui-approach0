# Frontend target relay URL.
# - Nếu dùng backend relay tích hợp sẵn: /search-relay/
# - Nếu dùng relay ngoài: http://192.168.1.39:8080 (hoặc http://<IP>:<PORT>)
A0_RELAY_URL=/search-relay/

# Backend search & log daemon hosts (dành cho relay tích hợp)
A0_SEARCHD=localhost
A0_SEARCHD_PORT=8921
A0_QRYLOGD=localhost
A0_QRYLOGD_PORT=3207
